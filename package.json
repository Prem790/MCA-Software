{
  "name": "mca-software",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run architecture:check && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:check": "drizzle-kit check",
    "architecture:check": "depcruise src --config config/dependency-cruiser.cjs",
    "account:provision": "tsx --conditions=react-server --env-file=.env scripts/provision-account.ts",
    "test:workspace": "playwright test --config config/playwright.workspace.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "@radix-ui/react-slot": "1.5.0",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "type": "module",
  "prettier": {
    "trailingComma": "all",
    "singleQuote": false
  }
}
