# Foundation mode serves the fictional preview without database credentials.
# Authentication is unavailable and readiness returns 503 in foundation mode.
APP_MODE=foundation
# On Vercel, set this to the exact stable HTTPS deployment origin.
APP_URL=http://localhost:3000

# Application mode enables real sign-in and the company workspace.
# Set APP_MODE=application after migration and administrator provisioning.
# Never commit actual credentials.
# Vercel runtime: use the Neon pooled connection string and retain TLS settings.
DATABASE_URL=
# Use a direct connection for migrations; falls back to DATABASE_URL when unset.
DATABASE_MIGRATION_URL=
# Generate locally with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Seed writes only when BOTH conditions hold. Use a separate disposable demo DB.
ALLOW_DEMO_SEED=false
SEED_DATABASE_URL=
