# Foundation mode serves the public homepage without database credentials. Sign-in is unavailable.
# Authentication is unavailable and readiness returns 503 in foundation mode.
APP_MODE=foundation
# On Vercel, set this to the exact stable HTTPS deployment origin.
APP_URL=http://localhost:3000

# Application mode enables real sign-in and the company workspace.
# Set APP_MODE=application after migration and administrator provisioning.
# Never commit actual credentials.
# Vercel runtime: use the Neon pooled connection string and retain TLS settings.
DATABASE_URL=
# Use a direct connection for migrations; falls back to DATABASE_URL when unset.
DATABASE_MIGRATION_URL=
# Generate locally with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Optional Phase 2B email. Disabled keeps existing login/company workflows working.
# Set EMAIL_DELIVERY=resend after verifying a sender domain in Resend.
EMAIL_DELIVERY=disabled
RESEND_API_KEY=
# Bare sender address on your verified domain, without display name or angle brackets.
EMAIL_FROM=

# Seed writes only when BOTH conditions hold. Use a separate disposable demo DB.
ALLOW_DEMO_SEED=false
SEED_DATABASE_URL=

# Optional: private Vercel Blob store (never a public store). Server-only token.
DOCUMENT_STORAGE=disabled
BLOB_READ_WRITE_TOKEN=
