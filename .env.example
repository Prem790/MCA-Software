# Foundation mode serves the shell/health endpoint without database credentials.
# Authentication is unavailable and readiness returns 503 in foundation mode.
APP_MODE=foundation
APP_URL=http://localhost:3000

# Set APP_MODE=application to enable DB/auth. Never commit actual credentials.
# Obtain the connection string from Neon; retain its TLS settings.
DATABASE_URL=
# Use a direct connection for migrations; falls back to DATABASE_URL when unset.
DATABASE_MIGRATION_URL=
# Generate locally with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Seed writes only when BOTH conditions hold. Use a separate disposable demo DB.
ALLOW_DEMO_SEED=false
SEED_DATABASE_URL=
